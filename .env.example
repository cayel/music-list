# Exemple de configuration environnement pour Music List
# Copiez ce fichier en .env puis ajustez les valeurs

# -------------------- Serveur --------------------
# Port d'écoute de l'API Express
PORT=3000

# Origine autorisée CORS ("*" pour toutes en dev)
#FRONT_ORIGIN=http://localhost:5173

# Nom d'environnement (affiché dans /api/status)
#ENV_NAME=local

# -------------------- Discogs --------------------
# Jeton Discogs personnel (https://www.discogs.com/settings/developers) 
# Permet d'augmenter les limites et d'obtenir des données plus fiables.
#DISCOGS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------- Base de données --------------------
# Choix automatique : si PG_CONNECTION_STRING ou DATABASE_URL est défini => Postgres, sinon SQLite.
# (SQLite) Chemin du fichier de base locale
DB_PATH=./music_collection.db

# (Postgres) Chaîne de connexion complète
#PG_CONNECTION_STRING=postgres://user:pass@host:5432/dbname
#DATABASE_URL=postgres://user:pass@host:5432/dbname

# -------------------- Administration --------------------
# Jeton protégeant les endpoints /api/admin/* (laisser vide pour aucune protection)
#ADMIN_TOKEN=changez-moi

# -------------------- Frontend (client Vite) --------------------
# Base URL de l'API lorsqu'on lance uniquement le client (sinon même origine)
# Vite exige préfixe VITE_
#VITE_API_BASE=http://localhost:3000

# -----------------------------------------------------------
# Notes:
# - FRONT_ORIGIN doit correspondre à l'adresse du client si différent.
# - Pour un déploiement Render/Neon/Supabase Postgres, laissez DB_PATH vide et définissez PG_CONNECTION_STRING.
# - ADMIN_TOKEN conseillé en production.
